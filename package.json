{
  "name": "@yolo-labs/yolo-cli",
  "version": "0.43.0",
  "description": "YOLO Studio CLI for workspace context, artifacts, personal apps and hosting.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "yolo": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*.js",
    "!dist/**/*.test.js",
    "dist/**/*.mjs",
    "dist/**/*.json",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && node scripts/build-vendored-flexdb.mjs",
    "test": "npm run build && node --test --test-reporter=spec dist/*.test.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "esbuild": "^0.24.0",
    "miniflare": "^3.20250718.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
